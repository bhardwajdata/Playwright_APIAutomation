{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "id",
        "email",
        "password",
        "name",
        "role",
        "avatar",
        "creationAt",
        "updatedAt"
    ],
    "properties": {
        "id": {
            "type": "integer"
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "password": {
            "type": "string",
            "minLength": 1
        },
        "name": {
            "type": "string",
            "minLength": 1
        },
        "role": {
            "type": "string",
            "enum": [
                "admin",
                "customer"
            ]
        },
        "avatar": {
            "type": "string",
            "format": "uri"
        },
        "creationAt": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        }
    }
}